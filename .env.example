# Drishti AI P0.1-P0.3 development configuration.
# Copy to .env and change local values. Never commit .env or real camera credentials.

APP_ENV=development
APP_NAME=Drishti AI Federation Control Plane
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
DB_ECHO=false
AUTO_CREATE_SCHEMA=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# No-Docker local default. This is not a production database.
DATABASE_URL=sqlite:///./drishti_registry.db

# Compose/PostGIS values. Set a unique local password before using Compose.
# There is deliberately no default password in the Compose manifest.
POSTGRES_DB=drishti_registry
POSTGRES_USER=drishti_app
POSTGRES_PASSWORD=
BACKEND_PORT=8000
FRONTEND_PORT=5173

# P0.3 federation control plane. The Fernet key protects both endpoints and
# local managed device credentials. Generate it at runtime; never commit a real
# key or expose any FEDERATION_* value through a VITE_* variable. Production
# requires managed key custody or an external Vault/KMS credential resolver.
FEDERATION_ENCRYPTION_KEY=
FEDERATION_ENCRYPTION_KEY_ID=local-development-key-v1
# In development only, an absent key is generated once beneath .runtime and
# reused across restarts. Production remains fail-closed and requires KMS/Vault.
FEDERATION_AUTO_DEVELOPMENT_KEY=true
FEDERATION_DEVELOPMENT_KEY_FILE=./.runtime/secrets/federation.key
# Private/loopback feeds are denied unless their exact approved CIDRs are listed.
FEDERATION_ALLOWED_CIDRS=
FEDERATION_PROBE_TIMEOUT_SECONDS=5
FEDERATION_MEDIA_ROOT=./runtime/media

# P0.3R supervised media runtime. `FFMPEG_BINARY` may be left empty when
# ffmpeg is available on PATH; the backend also checks its packaged fallback.
FFMPEG_BINARY=
FEDERATION_RUNTIME_ROOT=./runtime/streams
FEDERATION_RUNTIME_SEGMENT_SECONDS=2
FEDERATION_RUNTIME_PLAYLIST_WINDOW=6
FEDERATION_RUNTIME_WATCHDOG_SECONDS=12
FEDERATION_RUNTIME_MAX_BACKOFF_SECONDS=30
FEDERATION_RUNTIME_MAX_RESTARTS=8
FEDERATION_RUNTIME_STOP_TIMEOUT_SECONDS=5
FEDERATION_RUNTIME_MAX_ACTIVE_SESSIONS=8

# Government challenge feed catalogue. The connector discovers the current
# camera set dynamically; it does not assume IDs 1-30 remain permanent.
GOVERNMENT_FEED_CATALOGUE_URL=https://cctv.corp8.cloud/cameras.json
# Comma-separated direct media hosts that the catalogue is trusted to publish.
GOVERNMENT_FEED_RTSP_HOSTS=103.250.160.189
GOVERNMENT_FEED_CATALOGUE_TIMEOUT_SECONDS=10
GOVERNMENT_FEED_CATALOGUE_MAX_ITEMS=100
# Used only when the provider has location text but no surveyed coordinates.
# Such imports are visibly marked provisional until GIS verification.
GOVERNMENT_FEED_FALLBACK_LATITUDE=22.2587
GOVERNMENT_FEED_FALLBACK_LONGITUDE=71.1924

# P04 AI-ready stream processing unit. The evaluation node admits the 30-feed
# government grid plus two recovery slots; statewide scale uses edge units.
# auto probes nvidia-smi plus FFmpeg CUDA/CUVID support. It uses NVDEC when
# qualified and retries an incompatible stream on CPU FFmpeg automatically.
# Use ffmpeg to force CPU; nvdec means prefer NVDEC with the same safe fallback.
STREAM_ENGINE_DECODER_BACKEND=auto
STREAM_ENGINE_RTSP_TRANSPORT=tcp
STREAM_ENGINE_OUTPUT_WIDTH=640
STREAM_ENGINE_OUTPUT_HEIGHT=360
STREAM_ENGINE_DECODE_FPS=12
STREAM_ENGINE_TARGET_FPS=10
STREAM_ENGINE_BUFFER_SIZE=2
STREAM_ENGINE_MAX_FRAME_AGE_MS=750
STREAM_ENGINE_BATCH_SIZE=8
STREAM_ENGINE_BATCH_TIMEOUT_MS=40
STREAM_ENGINE_HEALTH_TIMEOUT_SECONDS=5
# Rolling HTTP/HLS playlists can stall while a segment is republished or expires.
STREAM_ENGINE_HTTP_HEALTH_TIMEOUT_SECONDS=30
# A bounded GOP/keyframe wait before rotating to the next transport profile.
STREAM_ENGINE_STARTUP_TIMEOUT_SECONDS=15
# HTTP/HLS may require redirect and playlist/segment acquisition.
STREAM_ENGINE_HTTP_STARTUP_TIMEOUT_SECONDS=30
STREAM_ENGINE_FREEZE_THRESHOLD_SECONDS=10
STREAM_ENGINE_MAX_BACKOFF_SECONDS=30
STREAM_ENGINE_STOP_TIMEOUT_SECONDS=5
STREAM_ENGINE_MAX_ACTIVE_SESSIONS=32
# Continuous wall previews. Six FPS remains smooth while bounding browser/network load.
STREAM_ENGINE_PREVIEW_FPS=6

# Read-only AI evidence projection used by the portal showcase. Keep the crop
# database outside source control when it contains operational imagery.
AI_SHOWCASE_DATABASE=./AI-Features/crops.db

# Per-camera live inference. The fair latest-frame scheduler processes every
# active camera without letting a slow feed block the wall. Vehicle and plate
# evidence is routed into AI_SHOWCASE_DATABASE; every vehicle in a retained frame is
# stored, while durable hybrid OCR and visual-intelligence queues remain non-blocking.
# This is the evidence retention cadence, not the preview/overlay frame rate.
LIVE_ANALYTICS_ENABLED=true
LIVE_ANALYTICS_GENERAL_MODEL=./AI-Features/models/yolo26n.pt
LIVE_ANALYTICS_PLATE_MODEL=./AI-Features/models/license_plate_detector.pt
LIVE_ANALYTICS_CONFIDENCE=0.40
LIVE_ANALYTICS_PLATE_CONFIDENCE=0.35
LIVE_ANALYTICS_EVIDENCE_INTERVAL_SECONDS=2
LIVE_ANALYTICS_OCR_ENABLED=true
LIVE_ANALYTICS_OCR_TIMEOUT_SECONDS=8
LIVE_ANALYTICS_OCR_COOLDOWN_SECONDS=4
LIVE_ANALYTICS_OCR_BATCH_SIZE=8
# High-confidence valid Google reads bypass Groq for speed. Only uncertain crops fall back.
LIVE_ANALYTICS_GOOGLE_ACCEPT_CONFIDENCE=0.86
LIVE_ANALYTICS_GROQ_OCR_ENABLED=true
LIVE_ANALYTICS_GROQ_ACCEPT_CONFIDENCE=0.82
LIVE_ANALYTICS_GROQ_OCR_REQUEST_INTERVAL_SECONDS=0.5

# Backend-only Visual Intelligence enrichment. Never expose the key through VITE_*.
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.6-27b
GROQ_REQUEST_TIMEOUT=45
GROQ_MAX_RETRIES=2
VISUAL_INTELLIGENCE_ENABLED=true
VISUAL_INTELLIGENCE_AUTO_ANALYZE=true
VISUAL_INTELLIGENCE_QUEUE_SIZE=64
VISUAL_INTELLIGENCE_REQUEST_INTERVAL_SECONDS=2

# Frontend/browser configuration. Never put a secret in a VITE_* variable.
VITE_API_BASE_URL=/api/v1

# ANPR OCR. Keep the service-account JSON outside source control. This path is
# consumed by Google Application Default Credentials and must never use VITE_*.
GOOGLE_APPLICATION_CREDENTIALS=
