# Keep this path when the frontend and API share an origin or Vite's proxy is used.
VITE_API_BASE_URL=/api/v1

# Local Vite proxy target (read by vite.config.ts).
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Optional government-hosted or offline-compatible raster tile service.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
