# Keep this path when the frontend and API share an origin or Vite's proxy is used.
VITE_API_BASE_URL=/api/v1

# Local Vite proxy target (read by vite.config.ts).
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Optional approved raster tile service. Blank uses the canonical OpenStreetMap endpoint.
# The default honors browser caching and sends the application origin as Referer.
VITE_MAP_TILE_URL=
# Optional native light/dark styles from your provider (otherwise use the shared URL).
VITE_MAP_LIGHT_TILE_URL=
VITE_MAP_DARK_TILE_URL=
# Required provider attribution HTML when using a custom service; blank uses linked OSM credit.
VITE_MAP_ATTRIBUTION=
# CARTO now requires your own basemap key. Add ?key=YOUR_KEY to CARTO URLs.
# https://carto.com/basemaps/apikey/
